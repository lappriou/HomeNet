@page "/"
@inject DeviceManager DeviceManager
@rendermode InteractiveServer
<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

@foreach (var device in DeviceManager.Devices)
{
    <MudCard>
        <MudCardHeader>
            <MudText Typo="Typo.h1">@device.Name</MudText>
        </MudCardHeader>
        <MudCardContent>
            @foreach (var state in device.States ?? Array.Empty<DeviceState>())
            {
                <HomeNet.Applications.BlazorApp.Components.Devices.DeviceStateComponent State="@state" />
            }
        </MudCardContent>
        <MudCardActions>
            @foreach (var action in device.Actions ?? Array.Empty<DeviceAction>())
            {
                <HomeNet.Applications.BlazorApp.Components.Devices.DeviceActionComponent Action="@action" />
            }
        </MudCardActions>
    </MudCard>
}


