@inject DeviceManager DeviceManager

<section class="devices-section" aria-labelledby="devices-heading">
    <div class="section-heading">
        <span class="device-count">
            @DeviceManager.Devices.Count
            <span>@(DeviceManager.Devices.Count == 1 ? "device" : "devices")</span>
        </span>
    </div>

    @if (DeviceManager.Devices.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.DevicesOther" /></span>
            <h3>No devices at this time</h3>
        </div>
    }
    else
    {
        <div class="device-grid">
            @foreach (var device in DeviceManager.Devices)
            {
                <DeviceCardComponent Device="@device" />
            }
        </div>
    }
</section>
