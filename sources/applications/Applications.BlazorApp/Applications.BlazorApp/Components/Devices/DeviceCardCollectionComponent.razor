@inject DeviceManager DeviceManager

<section class="devices-section" aria-labelledby="devices-heading">
    <div class="section-heading">
        <div>
            <p class="section-eyebrow">VOTRE ESPACE</p>
            <h2 id="devices-heading">Vos appareils</h2>
            <p class="section-description">Consultez leur état et accédez à leurs commandes.</p>
        </div>
        <span class="device-count">
            @DeviceManager.Devices.Count
            <span>@(DeviceManager.Devices.Count == 1 ? "appareil" : "appareils")</span>
        </span>
    </div>

    @if (DeviceManager.Devices.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-state-icon"><MudIcon Icon="@Icons.Material.Filled.DevicesOther" /></span>
            <h3>Aucun appareil pour le moment</h3>
            <p>Les appareils ajoutés à votre espace apparaîtront ici.</p>
        </div>
    }
    else
    {
        <div class="device-grid">
            @foreach (var device in DeviceManager.Devices)
            {
                <DeviceCardComponent Device="@device" />
            }
        </div>
    }
</section>
